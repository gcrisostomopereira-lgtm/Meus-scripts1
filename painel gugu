-- Função para buscar o jogador pelo que foi digitado
local function obterJogadorAlvo()
    local texto = SearchBox.Text:lower()
    if texto == "" then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name:lower():sub(1, #texto) == texto or (player.DisplayName and player.DisplayName:lower():sub(1, #texto) == texto) then
            return player
        end
    end
    return nil
end

-- Lista de Funções baseadas no vídeo (Lógica Executada)
local funcoes = {
    {
        Nome = "👢 Kick",
        Callback = function(alvo)
            if alvo then
                alvo:Kick("Você foi removido pelo Painel do Gugu.")
            end
        end
    },
    {
        Nome = "🚫 Ban",
        Callback = function(alvo)
            if alvo then
                if alvo == LocalPlayer then
                    LocalPlayer:Kick("Você foi banido pelo Painel do Gugu.")
                else
                    alvo:Destroy() -- Deleta o jogador na visão local
                end
            end
        end
    },
    {
        Nome = "🔒 Jail",
        Callback = function(alvo)
            if alvo and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = alvo.Character.HumanoidRootPart
                
                -- Cria uma barreira invisível/forçafield local ao redor do alvo
                local jaula = Instance.new("Part")
                jaula.Size = Vector3.new(6, 8, 6)
                jaula.CFrame = hrp.CFrame
                jaula.Transparency = 0.6
                jaula.BrickColor = BrickColor.new("White")
                jaula.Anchored = true
                jaula.Material = Enum.Material.ForceField
                jaula.Name = "JaulaGugu_" .. alvo.Name
                jaula.Parent = workspace
                
                if alvo == LocalPlayer then
                    hrp.Anchored = true
                end
            end
        end
    },
    {
        Nome = "🔓 Unjail",
        Callback = function(alvo)
            if alvo then
                local jaula = workspace:FindFirstChild("JaulaGugu_" .. alvo.Name)
                if jaula then jaula:Destroy() end
                
                if alvo == LocalPlayer and alvo.Character and alvo.Character:FindFirstChild("HumanoidRootPart") then
                    alvo.Character.HumanoidRootPart.Anchored = false
                end
            end
        end
    },
    {
        Nome = "🧊 Ice",
        Callback = function(alvo)
            if alvo and alvo.Character then
                for _, part in ipairs(alvo.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = true
                        part.BrickColor = BrickColor.new("Light blue")
                    end
                end
            end
        end
    },
    {
        Nome = "🔥 Unice",
        Callback = function(alvo)
            if alvo and alvo.Character then
                for _, part in ipairs(alvo.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Anchored = false
                    end
                end
            end
        end
    },
    {
        Nome = "❄️ Freeze",
        Callback = function(alvo)
            if alvo and alvo.Character and alvo.Character:FindFirstChild("Humanoid") then
                alvo.Character.Humanoid.WalkSpeed = 0
                alvo.Character.Humanoid.JumpPower = 0
            end
        end
    },
    {
        Nome = "☀️ Unfreeze",
        Callback = function(alvo)
            if alvo and alvo.Character and alvo.Character:FindFirstChild("Humanoid") then
                alvo.Character.Humanoid.WalkSpeed = 16
                alvo.Character.Humanoid.JumpPower = 50
            end
        end
    }
}

-- C-- Criando os botões dinamicamente no menu
for _, dados in ipairs(funcoes) do
    local Btn = Instance.new("TextButton")
    Btn.Text = dados.Nome
    Btn.TextColor3 = Cores.Texto
    Btn.BackgroundColor3 = Cores.BotaoAtivo
    Btn.Font = Enum.Font.SourceSansBold
    Btn.TextSize = 14
    Btn.BorderSizePixel = 0
    
    -- Efeito de Hover (Mudar de cor ao passar o mouse)
    Btn.MouseEnter:Connect(function()
        Btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end)
    Btn.MouseLeave:Connect(function()
        Btn.BackgroundColor3 = Cores.BotaoAtivo
    end)
    
    -- Evento de clique
    Btn.MouseButton1Click:Connect(function()
        local alvo = obterJogadorAlvo()
        if alvo then
            dados.Callback(alvo)
        else
            -- Se não digitar ninguém, executa as ações seguras em si mesmo
            if not dados.Nome:find("Kick") and not dados.Nome:find("Ban") then
                dados.Callback(LocalPlayer)
            end
        end
    end)
    
    Btn.Parent = ButtonsFrame
end

print("Painel Adm do Gugu inicializado!")
